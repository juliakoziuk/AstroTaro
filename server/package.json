{
  "name": "mystiq-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "tsc -p tsconfig.json && node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"dist/**/*.test.js\"",
    "start": "node dist/main",
    "migrate": "node --env-file=.env scripts/migrate.mjs",
    "migrate:deploy": "node scripts/migrate.mjs",
    "migrate:status": "node --env-file=.env scripts/migrate.mjs --status",
    "test:e2e": "tsc -p tsconfig.json && node scripts/e2e.mjs",
    "stripe:check": "tsc -p tsconfig.json && node --env-file=.env scripts/stripe-check.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/sequelize": "^12.0.0",
    "@nestjs/swagger": "^12.1.0",
    "astronomy-engine": "^2.1.19",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/sequelize": "^4.28.20",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2"
  }
}
