PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=AstroTarot
JWT_SECRET=change-me
# Ключ NASA (безкоштовно на https://api.nasa.gov); публічний DEMO_KEY дає лише 10 запитів на годину
NASA_API_KEY=DEMO_KEY
# AI-компаньйон. Без ключа відповідає локальний асистент (теми, поради, голос персон), але це не повноцінна модель.
# Варіант 1 — Claude: ANTHROPIC_API_KEY (+ ANTHROPIC_MODEL, за замовчуванням claude-sonnet-5-5)
# ANTHROPIC_API_KEY=
# Варіант 2 — будь-який OpenAI-сумісний сервіс (Ollama на своєму комп'ютері, Google Gemini, Groq, OpenRouter, Mistral…):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=
# Перевірка: cd server && npm run build && node --env-file=.env scripts/llm-check.mjs
JWT_EXPIRES=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5180
