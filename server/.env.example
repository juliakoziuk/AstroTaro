PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=AstroTarot
JWT_SECRET=change-me
# Ключ NASA (безкоштовно на https://api.nasa.gov); публічний DEMO_KEY дає лише 10 запитів на годину
NASA_API_KEY=DEMO_KEY
# AI-компаньйон. Без ключа відповідає локальний асистент (теми, поради, голос персон), але це не повноцінна модель.
# Варіант 1 — Claude: ANTHROPIC_API_KEY (+ ANTHROPIC_MODEL, за замовчуванням claude-sonnet-5-5)
# ANTHROPIC_API_KEY=
# Варіант 2 — будь-який OpenAI-сумісний сервіс (Ollama на своєму комп'ютері, Google Gemini, Groq, OpenRouter, Mistral…):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=
# Перевірка: cd server && npm run build && node --env-file=.env scripts/llm-check.mjs
JWT_EXPIRES=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5180

# Лише для локальної розробки (у продакшені лишити вимкненими):
# DB_SYNC=true — створювати й змінювати таблиці з моделей під час старту. Інакше схему веде `npm run migrate` (migrations/*.sql).
# ALLOW_DEMO_BILLING=true — дозволити вмикати платні тарифи без оплати (оплати ще немає; без цього працює лише безкоштовний).
DB_SYNC=true
ALLOW_DEMO_BILLING=true

# Листи (скидання пароля, підтвердження пошти). Без SMTP_URL лист лише друкується в консолі сервера разом з посиланням.
# SMTP_URL=smtps://user:password@smtp.example.com
# MAIL_FROM=MYSTIQ <no-reply@example.com>
# Адреса клієнта, куди ведуть посилання з листів
# APP_URL=http://localhost:5173

# Оплата тарифів через Stripe (підписка). Ключі тестового режиму: https://dashboard.stripe.com/test/apikeys
# Створіть у Stripe два Price (Pro і Premium, щомісячні) і вкажіть їхні id; вебхук на POST /api/billing/webhook
# з подіями checkout.session.completed, customer.subscription.created, customer.subscription.updated, customer.subscription.deleted дає STRIPE_WEBHOOK_SECRET
# (локально: stripe listen --forward-to localhost:3000/api/billing/webhook).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_PREMIUM=price_...
